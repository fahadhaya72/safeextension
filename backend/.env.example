# Server Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# CORS Configuration
ALLOWED_ORIGIN=http://localhost:3000

# Cache Configuration
CACHE_TTL_SECONDS=900

# API Keys
SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here
WHOIS_NINJA_API_KEY=your_api_ninjas_whois_api_key_here

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_change_this_in_production_at_least_32_chars
JWT_EXPIRES_IN=24h

# 🔐 PRODUCTION SECURITY (REQUIRED FOR PRODUCTION)
SAFEEXTENSION_API_KEY=your_secure_api_key_here_change_this_in_production
CHROME_EXTENSION_ID=your_extension_id_here

# Production Settings (uncomment for production)
# NODE_ENV=production
# ALLOWED_ORIGIN=chrome-extension://your_extension_id
# LOG_LEVEL=warn
